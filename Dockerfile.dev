FROM node:22.23.4-alpine
RUN node -e "if (process.version !== 'v22.23.4' || typeof require('node:zlib').constants.BROTLI_DECODER_ERROR_FORMAT_BLOCK_SWITCH !== 'number') throw new Error('Patched Node 22 with the Brotli fix is required')"
WORKDIR /app

# Required for Next.js telemetry and sharp
RUN apk add --no-cache libc6-compat

RUN corepack enable

COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3000
CMD ["pnpm", "dev", "--hostname", "0.0.0.0"]
